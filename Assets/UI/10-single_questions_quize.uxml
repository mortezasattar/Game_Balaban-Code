            <ui:Label tabindex="-1" display-tooltip-when-elided="true" text="You have 200,000 . What’s the smarter choice?&#10;" name="question_txt" style="color: rgb(113, 113, 113); font-size: 40px; padding-left: 50px; padding-top: 50px; padding-bottom: 70px; padding-right: 50px; background-image: url(&quot;project://database/Assets/UI/Textures/UI-01.png?fileID=81330277&amp;guid=7d59cad3d698acb42935929c61783c8f&amp;type=3#UI-01_9&quot;); width: 100%; white-space: normal; -unity-font: url(&quot;project://database/Assets/Fonts/Fredoka-SemiBold.ttf?fileID=12800000&amp;guid=a7860a9b79ea3fb4fae0da26f789d122&amp;type=3#Fredoka-SemiBold&quot;);" />
