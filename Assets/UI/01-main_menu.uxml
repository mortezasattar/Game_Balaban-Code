    <ui:VisualElement name="scores" style="height: 10%; visibility: visible; -unity-background-image-tint-color: rgb(255, 0, 16); background-color: rgba(255, 0, 0, 0); width: 100%; justify-content: space-around; flex-direction: row; align-items: center; padding-left: 40px; padding-right: 40px; margin-top: 82px;">
