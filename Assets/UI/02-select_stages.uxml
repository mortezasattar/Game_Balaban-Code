            <ui:Button text="Button" display-tooltip-when-elided="true" name="close" style="position: absolute; top: 6px; right: 10px; width: 130px; height: 130px; background-image: url(&quot;project://database/Assets/UI/Textures/UI-1.psd?fileID=917536717&amp;guid=076d5656f656c65468ac80c77fd761d4&amp;type=3#btn-close&quot;); background-color: rgba(88, 88, 88, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
        </ui:VisualElement>
        <ui:VisualElement style="width: 90%; height: 10%; flex-direction: row; justify-content: space-around; align-items: center; border-bottom-color: rgba(255, 255, 255, 0.56); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-left-color: rgba(255, 255, 255, 0.56); border-right-color: rgba(255, 255, 255, 0.56); border-top-color: rgba(255, 255, 255, 0.56); color: rgb(106, 106, 106); -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/UI/Textures/UI-01.png?fileID=81330277&amp;guid=7d59cad3d698acb42935929c61783c8f&amp;type=3#UI-01_9&quot;); padding-bottom: 13px;">
            <ui:VisualElement name="coins" style="height: 75%; width: 40%; justify-content: flex-start; align-items: center; background-image: none; flex-direction: row;">
                <ui:VisualElement style="width: 110px; background-image: url(&quot;project://database/Assets/Render%20Textures/money.renderTexture?fileID=8400000&amp;guid=82b95fc6308b70e4ba3e17a56109b21f&amp;type=2#money&quot;); height: 107px; margin-left: 18px; margin-bottom: 12px;" />
                <ui:Label tabindex="-1" text="99999" display-tooltip-when-elided="true" name="money" style="position: relative; align-items: flex-start; justify-content: center; width: auto; height: 50%; font-size: 80px; -unity-text-align: middle-left; margin-left: 20px; margin-right: 0; margin-top: 0; margin-bottom: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="stars" style="height: 75%; width: 40%; justify-content: flex-start; align-items: center; background-image: none; flex-direction: row;">
                <ui:VisualElement style="width: 115px; background-image: url(&quot;project://database/Assets/Render%20Textures/Star.renderTexture?fileID=8400000&amp;guid=f3597b5ac9da55c49a961030bcc31e14&amp;type=2#Star&quot;); height: 132px; margin-left: 32px; -unity-background-scale-mode: scale-to-fit; margin-top: -9px;" />
                <ui:Label tabindex="-1" text="1500" display-tooltip-when-elided="true" style="position: relative; align-items: flex-start; justify-content: center; width: auto; height: 50%; font-size: 80px; -unity-text-align: middle-left; margin-left: 20px; margin-right: 0; margin-top: 0; margin-bottom: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;" />
        <ui:VisualElement style="width: 100%; height: 40%; align-items: center; justify-content: center;">
            <ui:VisualElement style="flex-grow: 0; height: 100%; width: 67%; background-image: url(&quot;project://database/Assets/UI/Textures/UI-01.png?fileID=81330277&amp;guid=7d59cad3d698acb42935929c61783c8f&amp;type=3#UI-01_9&quot;); -unity-background-scale-mode: stretch-to-fill; -unity-text-align: middle-center; margin-bottom: 86px; align-items: center; justify-content: center; padding-top: 97px; padding-bottom: 81px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; width: 60%; color: rgb(103, 103, 103); -unity-font-style: bold; -unity-background-image-tint-color: rgb(224, 212, 212); background-color: rgb(248, 246, 242); border-top-left-radius: 63px; border-bottom-left-radius: 63px; border-top-right-radius: 63px; border-bottom-right-radius: 63px; border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; border-left-color: rgb(231, 231, 231); border-right-color: rgb(231, 231, 231); border-top-color: rgb(231, 231, 231); border-bottom-color: rgb(231, 231, 231);">
