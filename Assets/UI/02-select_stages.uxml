                    <ui:VisualElement style="width: 117px; background-image: url(&quot;project://database/Assets/Render%20Textures/money.renderTexture?fileID=8400000&amp;guid=82b95fc6308b70e4ba3e17a56109b21f&amp;type=2#money&quot;); height: 116px; margin-left: 4px; background-color: rgba(0, 0, 0, 0);" />
                </ui:VisualElement>
                <ui:Label tabindex="-1" text="GET STARTED" display-tooltip-when-elided="true" style="max-width: 80%; max-height: none; width: 80%; font-size: 86px; color: rgb(70, 70, 70); margin-top: 13px; margin-bottom: 25px; text-shadow: 0 5px 0 rgba(0, 0, 0, 0.22);" />
                <ui:Button display-tooltip-when-elided="true" name="lets_go" style="background-image: url(&quot;project://database/Assets/UI/Textures/UI-1.psd?fileID=673778948&amp;guid=076d5656f656c65468ac80c77fd761d4&amp;type=3#Letsgo-btn&quot;); width: 80%; height: 150px; -unity-background-scale-mode: scale-to-fit; background-color: rgba(88, 88, 88, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
