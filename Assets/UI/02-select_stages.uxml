<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="width: 100%; height: 100%; color: rgba(210, 210, 210, 0.19); align-items: center; justify-content: center; -unity-font: url(&quot;project://database/Assets/Fonts/SourGummy-Bold.ttf?fileID=12800000&amp;guid=674e8dc1c3c722242876875d7a2a0e63&amp;type=3#SourGummy-Bold&quot;); -unity-font-definition: none;">
