###############################################################################
# Unity .gitattributes
# Ensures consistent line endings and prevents Git from messing with binaries
###############################################################################

# Default: normalize text files to LF
* text=auto eol=lf

###############################################################################
# Text files (force LF)
###############################################################################
*.cs           text eol=lf
*.shader       text eol=lf
*.cginc        text eol=lf
*.hlsl         text eol=lf
*.compute      text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.txt          text eol=lf
*.md           text eol=lf
*.asmdef       text eol=lf
*.rsp          text eol=lf
*.ts           text eol=lf
*.js           text eol=lf
*.html         text eol=lf
*.css          text eol=lf

###############################################################################
# Unity serialized/binary assets (do NOT touch line endings)
###############################################################################
*.unity        binary
*.prefab       binary
*.asset        binary
*.anim         binary
*.controller   binary
*.physicMaterial2D binary
*.physicMaterial  binary
*.mat          binary
*.giparams     binary
*.cubemap      binary
*.terrainlayer binary

###############################################################################
# 3D Models
###############################################################################
*.fbx          binary
*.obj          binary
*.blend        binary
*.dae          binary
*.3ds          binary

###############################################################################
# Audio
###############################################################################
*.wav          binary
*.ogg          binary
*.mp3          binary
*.aiff         binary

###############################################################################
# Images / Textures
###############################################################################
*.png          binary
*.jpg          binary
*.jpeg         binary
*.tga          binary
*.psd          binary
*.tiff         binary
*.exr          binary
*.hdr          binary

###############################################################################
# Fonts
###############################################################################
*.ttf          binary
*.otf          binary

###############################################################################
# Other binaries
###############################################################################
*.dll          binary
*.exe          binary
*.zip          binary
*.unitypackage binary
